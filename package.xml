<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arena_benchmark</name>
  <version>0.1.0</version>
  <description>Benchmark dataset generation: expand a spec into episodes, run them as sharded launches, and assemble a scenario suite with the evidence that certifies it.</description>
  <maintainer email="anhdd4work@gmail.com">Anh Do Duc</maintainer>
  <license>MIT</license>

  <exec_depend>task_generator</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-attrs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
